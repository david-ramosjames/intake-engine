# ---------------------------------------------------------------------------
# Intake Engine — environment configuration
# Copy to `.env` and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL (Railway). The app runs in DEMO mode without this set.
DATABASE_URL="postgresql://user:password@localhost:5432/intake_engine?schema=public"

# Auth.js — generate with `openssl rand -base64 32`
AUTH_SECRET=""

# Google OAuth (sign-in). Create credentials at console.cloud.google.com.
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google
# (Auth.js also accepts the AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET names.)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Only this email domain may sign in (Google Workspace). Defaults to ramosjames.com.
ALLOWED_EMAIL_DOMAIN="ramosjames.com"

# Root domain used to distinguish the platform app from tenant white-label
# domains. e.g. app.intakeengine.com -> platform; intake.ramosjames.com -> tenant
PLATFORM_ROOT_DOMAIN="localhost:3000"

# S3-compatible object storage (uploads, signatures, documents)
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_BUCKET="intake-engine"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# AI provider (Claude). Powers the AI Engine (qualification, summaries, OCR).
ANTHROPIC_API_KEY=""

# OpenAI — powers the journey editor's "Auto-translate to Spanish" button.
# OPENAI_MODEL defaults to gpt-4o-mini; OPENAI_API_BASE is only for testing.
OPENAI_API_KEY=""
OPENAI_MODEL=""

# Sign Flow — the app that creates DocuSeal contracts + runs SMS follow-ups.
# Used by "sign" steps to create a pre-filled contract the visitor signs inline.
# SIGNFLOW_BASE_URL is the Sign Flow app URL (not DocuSeal); the token must match
# Sign Flow's SIGNFLOW_INTAKE_TOKEN.
SIGNFLOW_BASE_URL=""
SIGNFLOW_INTAKE_TOKEN=""

# Outbound email — Google Workspace service account (preferred). Domain-wide
# delegation must include https://www.googleapis.com/auth/gmail.send, and
# GMAIL_SEND_AS must be a user the service account is allowed to impersonate.
GMAIL_SERVICE_ACCOUNT_EMAIL=""
GMAIL_SERVICE_ACCOUNT_PRIVATE_KEY=""
GMAIL_SEND_AS=""
# Optional: paste the whole JSON key instead of the two fields above.
# GMAIL_SERVICE_ACCOUNT_JSON=""

# Optional fallback if Gmail isn't set (lead automations used this first).
# RESEND_API_KEY=""
# AUTOMATION_EMAIL_FROM=""

# Optional cron poke for the weekly report. Not required if you only use Send now.
CRON_SECRET=""
