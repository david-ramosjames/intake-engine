# ---------------------------------------------------------------------------
# Intake Engine — environment configuration
# Copy to `.env` and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL (Railway). The app runs in DEMO mode without this set.
DATABASE_URL="postgresql://user:password@localhost:5432/intake_engine?schema=public"

# Auth.js — generate with `openssl rand -base64 32`
AUTH_SECRET=""

# Root domain used to distinguish the platform app from tenant white-label
# domains. e.g. app.intakeengine.com -> platform; intake.ramosjames.com -> tenant
PLATFORM_ROOT_DOMAIN="localhost:3000"

# S3-compatible object storage (uploads, signatures, documents)
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_BUCKET="intake-engine"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# AI provider (Claude). Powers the AI Engine (qualification, summaries, OCR).
ANTHROPIC_API_KEY=""
