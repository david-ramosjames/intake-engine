# ---------------------------------------------------------------------------
# Intake Engine — environment configuration
# Copy to `.env` and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL (Railway). The app runs in DEMO mode without this set.
DATABASE_URL="postgresql://user:password@localhost:5432/intake_engine?schema=public"

# Auth.js — generate with `openssl rand -base64 32`
AUTH_SECRET=""

# Google OAuth (sign-in). Create credentials at console.cloud.google.com.
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google
# (Auth.js also accepts the AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET names.)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Only this email domain may sign in (Google Workspace). Defaults to ramosjames.com.
ALLOWED_EMAIL_DOMAIN="ramosjames.com"

# Root domain used to distinguish the platform app from tenant white-label
# domains. e.g. app.intakeengine.com -> platform; intake.ramosjames.com -> tenant
PLATFORM_ROOT_DOMAIN="localhost:3000"

# S3-compatible object storage (uploads, signatures, documents)
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_BUCKET="intake-engine"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# AI provider (Claude). Powers the AI Engine (qualification, summaries, OCR).
ANTHROPIC_API_KEY=""

# OpenAI — powers the journey editor's "Auto-translate to Spanish" button.
# OPENAI_MODEL defaults to gpt-4o-mini; OPENAI_API_BASE is only for testing.
OPENAI_API_KEY=""
OPENAI_MODEL=""
